-- Mapa de España en franjas: { fila, x0, x1, región } con x en 0..1 y región = índice de
-- MapData.regions (0 = país vecino). Canarias va en un recuadro abajo a la izquierda.

local MapData = {}
MapData.aspect = 1.18896 -- ancho / alto
MapData.rows = 130
MapData.regions = { "CEN", "LEV", "CAT", "AND", "NOR", "CYL", "GAL", "BAL", "CAN" }
MapData.canaryBox = { 0.0175, 0.8542, 0.2310, 0.1250 } -- x, y, ancho, alto

-- Posición (0..1) de una coordenada real; Canarias se lleva a su recuadro
function MapData.project(lat: number, lon: number): (number, number)
	if lon < -12.5 and lat < 30 then
		return (0.2 + (lon - (-18.3)) * 0.87882 * 0.6) / 11.41406, (8.20000 + (29.5 - lat) * 0.6) / 9.60000
	end
	return (lon - (-10.2)) * 0.76604 / 11.41406, (44.2 - lat) / 9.60000
end

