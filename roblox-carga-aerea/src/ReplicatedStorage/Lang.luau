function Lang.t(lang: string, key: string, params: { [string]: any }?): string
	local text = (Lang :: any)[lang] and (Lang :: any)[lang][key] or Lang.en[key] or key
	if params then
		text = string.gsub(text, "{(%w+)}", function(k)
			local v = params[k]
			return v ~= nil and tostring(v) or "{" .. k .. "}"
		end)
	end
	return text
end

return Lang
